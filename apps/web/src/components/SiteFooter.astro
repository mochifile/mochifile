---
/**
 * The site footer (V2 canvas: MFFooter; ADR 0030), centred on the page ground: three link
 * columns (popular tools, video, install), "View all solutions" and "Read guides", the company
 * and legal links, the language row, the credit, GitHub, two badges and the "Ask AI" line.
 *
 * Everything the canvas draws is here. A destination that does not exist yet is a `ComingSoon`
 * control instead of a link, and a language with no pages is listed the same way; see
 * lib/site-nav.ts. The only addition to the canvas is the "Open-source licenses" link at the end
 * of the footer: the third-party notice is published and must stay reachable.
 *
 * Under 600 px the link columns stack in one, so long Portuguese labels and 200% zoom never
 * squeeze them.
 */
import { type Locale, localeTags } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import {
  askAiTargets,
  CREDIT_URL,
  companyLinks,
  footerColumns,
  GITHUB_REPOSITORY,
  shellLanguages,
} from '../lib/site-nav.ts'
import { tools } from '../lib/tools.ts'
import ComingSoon from './ComingSoon.astro'

interface Props {
  locale: Locale
  /** Path of this page in every locale. */
  paths: Record<Locale, string>
}

const { locale, paths } = Astro.props
const columns = footerColumns(locale, tools)
const company = companyLinks(locale)
const languages = shellLanguages.map((language) => ({
  ...language,
  href: language.locale ? paths[language.locale] : undefined,
  hreflang: language.locale ? localeTags[language.locale] : undefined,
  current: language.locale === locale,
}))

const columnLink =
  'press flex min-h-footer-link items-center justify-center rounded-sm type-footer-link hover:underline focus-ring'
const smallLink =
  'inline-flex min-h-footer-link items-center rounded-sm px-link-x type-footer-small text-ink-muted hover:text-ink hover:underline focus-ring'
const softPill =
  'press inline-flex min-h-target-min items-center justify-center rounded-pill border-hairline border-card-line bg-surface-card px-pill-sm type-button-sm text-accent shadow-card focus-ring'
const primaryPill =
  'press inline-flex min-h-target-min items-center justify-center rounded-pill bg-action px-pill-sm type-button-sm text-action-ink shadow-action focus-ring'
const badge =
  'press inline-flex min-h-badge items-center gap-badge-gap rounded-small border-hairline border-card-line bg-surface-card pr-badge-end pl-badge-start text-left text-ink shadow-card focus-ring'
const askAiLink =
  'inline-flex min-h-footer-link items-center rounded-sm px-1 hover:text-ink hover:underline focus-ring'
const githubPath =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
---

<footer class="mx-auto flex max-w-site-max flex-col items-center gap-8 px-5 pt-section pb-footer-end text-center text-ink sm:px-8">
  <div class="grid grid-cols-1 justify-center gap-x-14 gap-y-5 sm:grid-cols-[repeat(3,minmax(0,var(--spacing-footer-column)))] sm:gap-y-6">
    {
      columns.map((column) => (
        <nav aria-labelledby={`footer-${column.key}`}>
          <p
            id={`footer-${column.key}`}
            class="mb-2 type-footer-heading text-ink-muted uppercase"
          >
            {column.heading}
          </p>
          <ul>
            {column.links.map((link) => (
              <li>
                {link.href ? (
                  <a href={link.href} class={columnLink}>
                    {link.label}
                  </a>
                ) : (
                  <ComingSoon locale={locale} class={`${columnLink} w-full`} data-shell-link={link.key}>
                    {link.label}
                  </ComingSoon>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="flex flex-wrap items-center justify-center gap-3">
    <ComingSoon locale={locale} class={softPill} data-shell-link="view-solutions">
      {m.footer_view_solutions({}, { locale })}
    </ComingSoon>
    <ComingSoon locale={locale} class={primaryPill} data-shell-link="read-guides">
      {m.footer_read_guides({}, { locale })}
    </ComingSoon>
  </div>
  <div class="flex flex-col items-center gap-2">
    <nav aria-label={m.footer_company_legal({}, { locale })}>
      <ul class="flex flex-wrap justify-center gap-x-1">
        {
          company.map((link) => (
            <li>
              <ComingSoon locale={locale} class={smallLink} data-shell-link={link.key}>
                {link.label}
              </ComingSoon>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* Each language in its own name, no flags; English and Portuguese have pages (ADR 0007). */}
    <nav aria-label={m.nav_language({}, { locale })}>
      <ul class="flex flex-wrap justify-center gap-x-1">
        {
          languages.map((language) => (
            <li>
              {language.href ? (
                <a
                  href={language.href}
                  hreflang={language.hreflang}
                  lang={language.tag}
                  aria-current={language.current ? 'true' : undefined}
                  data-language-switch
                  class={`${smallLink} aria-[current=true]:font-extrabold aria-[current=true]:text-ink`}
                >
                  {language.name}
                </a>
              ) : (
                <ComingSoon
                  locale={locale}
                  class={smallLink}
                  data-shell-link={`language-${language.tag}`}
                >
                  <span lang={language.tag}>{language.name}</span>
                </ComingSoon>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="flex flex-col items-center gap-3">
    <p class="type-credit text-ink-muted">
      {m.footer_made_with({}, { locale })}{' '}
      <span class="text-heart" role="img" aria-label={m.footer_love({}, { locale })}>♥</span>{' '}
      {m.footer_made_by({}, { locale })}{' '}
      <a href={CREDIT_URL} class="rounded-sm font-bold text-accent focus-ring">RaioViajante</a>
    </p>
    {/* The only social network. */}
    <a
      href={GITHUB_REPOSITORY}
      aria-label={m.footer_github({}, { locale })}
      class="press inline-flex size-target-min items-center justify-center rounded-pill text-ink focus-ring"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d={githubPath}></path>
      </svg>
    </a>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href={GITHUB_REPOSITORY} aria-label={m.footer_badge_open_source({}, { locale })} class={badge}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={githubPath}></path>
        </svg>
        <span class="flex flex-col">
          <small class="type-badge-label text-ink-muted uppercase">
            {m.footer_badge_open_source_small({}, { locale })}
          </small>
          <b class="type-badge-title">{m.footer_badge_open_source_main({}, { locale })}</b>
        </span>
      </a>
      {/* Sponsorship is not set up: the badge is drawn and says so when pressed. */}
      <ComingSoon locale={locale} class={badge} data-shell-link="sponsor">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="text-heart"
        >
          <path d="M12 20s-7-4.4-9.3-9A5 5 0 0 1 12 6a5 5 0 0 1 9.3 5c-2.3 4.6-9.3 9-9.3 9z"></path>
        </svg>
        <span class="flex flex-col">
          <small class="type-badge-label text-ink-muted uppercase">
            {m.footer_badge_sponsor_small({}, { locale })}
          </small>
          <b class="type-badge-title">Mochifile</b>
        </span>
      </ComingSoon>
    </div>
    <p class="flex flex-wrap items-center justify-center gap-x-ask-gap type-footer-note text-ink-muted">
      <span class="font-bold text-accent">{m.footer_ask_ai({}, { locale })}</span>
      {
        askAiTargets.map((target, index) => (
          <>
            {index > 0 && <i aria-hidden="true" class="size-1 rounded-pill bg-border-dashed" />}
            <ComingSoon locale={locale} class={askAiLink} data-shell-link={target.key}>
              {target.label}
            </ComingSoon>
          </>
        ))
      }
    </p>
    <a href="/third-party-licenses.txt" class={`${askAiLink} type-footer-note text-ink-muted`}>
      {m.footer_licenses({}, { locale })}
    </a>
  </div>
</footer>
