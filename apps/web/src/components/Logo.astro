---
import dark368 from '../assets/logo/mochifile-wordmark-dark-368.png'
import dark552 from '../assets/logo/mochifile-wordmark-dark-552.png'
import light368 from '../assets/logo/mochifile-wordmark-light-368.png'
import light552 from '../assets/logo/mochifile-wordmark-light-552.png'

/**
 * The official Mochifile lettering (ADR 0024, ADR 0030): the lowercase wordmark, a raster used as
 * it is, never redrawn or set in a font. The masters are in docs/design-system/assets/Logos;
 * these are their 368 and 552 px copies (a 151px logo at 2x and 3x), so a visitor downloads
 * 12 KB, not the 280 KB master. The names say the colour scheme the lettering is shown in: `light` is ink
 * for light grounds, `dark` is cream for dark ones. The i-dots keep their colours in both.
 *
 * On page grounds (`light`, the default) both files are in the page and global.css shows the
 * one that matches the theme with the selectors the tokens use (system preference, or a forced
 * `data-theme`), so no script runs. Both are lazy, so the browser never fetches the hidden one.
 * `on-dark` shows only the cream file, for ink grounds.
 *
 * The link's accessible name is "Mochifile"; the images are decorative and hidden from
 * assistive technology, so the name is announced once. Width is `w-logo` (151px, 28px tall) on
 * every screen, above the 96px minimum. Callers keep the height of the "o" clear around it. The images carry their
 * size and global.css pins each one's proportions, so the box is reserved before they load and
 * never changes when a file of another size arrives.
 */

interface Props {
  href: string
  /** `light` (default) for page grounds, `on-dark` for the ink footer. */
  ground?: 'light' | 'on-dark'
}

const { href, ground = 'light' } = Astro.props
const light = { scheme: 'light', small: light368, large: light552, width: 1800, height: 333 }
const dark = { scheme: 'dark', small: dark368, large: dark552, width: 1908, height: 353 }
const wordmarks = ground === 'on-dark' ? [dark] : [light, dark]
---

<a
  href={href}
  aria-label="Mochifile"
  data-logo
  data-logo-themed={ground === 'light' ? '' : undefined}
  class="inline-flex w-logo shrink-0 rounded-sm focus-ring"
>
  {
    wordmarks.map(({ scheme, small, large, width, height }) => (
      <img
        src={small.src}
        srcset={`${small.src} ${small.width}w, ${large.src} ${large.width}w`}
        sizes="151px"
        alt=""
        aria-hidden="true"
        data-wordmark={scheme}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
    ))
  }
</a>
