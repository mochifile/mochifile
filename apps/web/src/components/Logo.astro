---
import LogoOnLight from '../assets/logo/mochifile-logo-horizontal.svg'
import LogoOnDark from '../assets/logo/mochifile-logo-horizontal-on-dark.svg'

/**
 * The Mochifile logo (final v1, docs/design-system README › Logo): the horizontal lockup from
 * docs/design-system/assets/Logos, drawn as vectors, never set in a font. Inline SVG, so it
 * costs no request. On light grounds the letters follow the text colour (ink in the light and
 * dark themes, matching the light and on-dark files); `on-dark` is the on-dark file as drawn,
 * for the ink footer. The symbol and the i-dots keep their fixed colours in every theme.
 *
 * The link's accessible name is "Mochifile"; the drawing is hidden from assistive technology.
 * Width is `w-logo-phone` (120px) under 600px and `w-logo` (200px) from 600px, above the 96px
 * minimum; callers keep the clear space (the "o"'s height, 0.57 × the logo's height) around it.
 */

interface Props {
  href: string
  /** `light` (default) for page grounds, `on-dark` for the ink footer. */
  ground?: 'light' | 'on-dark'
}

const { href, ground = 'light' } = Astro.props
const Drawing = ground === 'on-dark' ? LogoOnDark : LogoOnLight
---

<a
  href={href}
  aria-label="Mochifile"
  data-logo
  class="inline-flex w-logo-phone shrink-0 rounded-sm text-ink focus-ring sm:w-logo"
>
  <Drawing aria-hidden="true" focusable="false" class="block h-auto w-full" />
</a>
