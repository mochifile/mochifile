---
/**
 * A code example in three languages (cURL, JavaScript, Python), as tabs with no script: the
 * tabs are a radio group and `:has()` shows the panel of the chosen one (the same technique as
 * the topic chips of the guides). With the keyboard, the arrow keys move between tabs. Every
 * panel is in the HTML, so none of the code depends on the choice. The code is illustrative:
 * the API it calls does not exist yet.
 */
import { type Example, exampleLanguages, highlightCode } from '../lib/docs-api'

interface Props {
  /** Unique on the page: names the radio group. */
  id: string
  example: Example
  /** Accessible name of the group of tabs. */
  label: string
}

const { id, example, label } = Astro.props
---

<div class="docs-tabs flex flex-col gap-3">
  <fieldset class="flex flex-wrap gap-2">
    <legend class="sr-only">{label}</legend>
    {
      exampleLanguages.map(({ key, label: name }) => (
        <label class="docs-tab press inline-flex min-h-target-min cursor-pointer items-center rounded-pill border-hairline border-card-line bg-surface-card shadow-chip px-4 type-body-sm has-[:checked]:border-ink has-[:checked]:bg-action has-[:checked]:font-bold has-[:checked]:text-action-ink">
          <input type="radio" name={`${id}-language`} value={key} checked={key === 'curl'} class="sr-only" />
          {name}
        </label>
      ))
    }
  </fieldset>
  {
    exampleLanguages.map(({ key }) => (
      <pre data-panel={key} class="docs-code"><code set:html={highlightCode(example[key])} /></pre>
    ))
  }
</div>
