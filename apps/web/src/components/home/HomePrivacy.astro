---
/** "Private by design": what happens to a file in the browser tools, with the happy mascot. */
import type { Locale } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import happy from '../../assets/home/sheet-happy-800.webp'
import Icon from './Icon.astro'

interface Props {
  locale: Locale
  /** Architecture page, when it is published. */
  builtHref: string | undefined
}
const { locale, builtHref } = Astro.props
const repo = 'https://github.com/mochifile/mochifile'
const githubPath =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
---

<section class="hv2-w hv2-sec-sm" aria-labelledby="hv2-privacy-title">
  <div class="hv2-card hv2-card-privacy">
    <div class="hv2-split hv2-privacy-split">
      <img src={happy.src} width={happy.width} height={happy.height} alt="" loading="lazy" decoding="async" class="hv2-media" />
      <div class="hv2-stack hv2-g16">
        <span class="hv2-eyebrow">{m.hv2_privacy_eyebrow({}, { locale })}</span>
        <h2 id="hv2-privacy-title" class="hv2-h2">{m.hv2_privacy_title({}, { locale })}</h2>
        <p class="hv2-lead hv2-lead-sm">{m.hv2_privacy_text({}, { locale })}</p>
        <div class="hv2-row hv2-g12">
          {
            builtHref ? (
              <a class="hv2-btn hv2-btn-soft" href={builtHref}>
                {m.hv2_privacy_built({}, { locale })}
                <Icon d="M5 12h14M13 6l6 6-6 6" size={16} />
              </a>
            ) : (
              <button type="button" class="hv2-btn hv2-btn-soft" popovertarget="hv2-soon">
                {m.hv2_privacy_built({}, { locale })}
                <Icon d="M5 12h14M13 6l6 6-6 6" size={16} />
              </button>
            )
          }
          <a class="hv2-btn hv2-btn-soft" href={repo}>
            <Icon d={githubPath} fill />
            {m.hv2_privacy_code({}, { locale })}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
