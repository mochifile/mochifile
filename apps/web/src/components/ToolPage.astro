---
import { getEntry, render } from 'astro:content'
import { localePath } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import { formatBytes } from '@mochifile/tool-kit'
import celebrate from '../assets/tool/expr-celebrate.webp'
import determined from '../assets/tool/expr-determined.webp'
import normal from '../assets/tool/expr-normal.webp'
import sad from '../assets/tool/expr-sad.webp'
import BaseLayout from '../layouts/BaseLayout.astro'
import { stepParts } from '../lib/page-copy.ts'
import { serializeJsonLd, toolJsonLd } from '../lib/seo'
import { shellPaths } from '../lib/site-nav'
import { contentId, type ToolPageProps, toolPages, tools } from '../lib/tools'
import '../styles/tool-page.css'
import '../styles/tool-page-light.css'
import ToolIsland from './ToolIsland'

type Props = ToolPageProps

const { page, locale } = Astro.props
const { tool, variant, paths } = page
const { manifest } = tool
const meta = page.meta[locale]
const maxSize = formatBytes(manifest.limits.maxFileSizeBytes, locale)
const site = Astro.site ?? Astro.url
const absolute = (path: string) => new URL(path, site).href
// Each category has its colour (design system README › Colour): the tile and tag of its cards.
const categoryTint = {
  image: 'tp-tint-mango',
  media: 'tp-tint-ube',
  pdf: 'tp-tint-strawberry',
} as const satisfies Record<typeof manifest.category, string>
const categoryLabel = {
  image: m.category_image({}, { locale }),
  media: m.category_media({}, { locale }),
  pdf: m.category_pdf({}, { locale }),
} as const satisfies Record<typeof manifest.category, string>

// Presence is guaranteed by assertContentComplete() in getStaticPaths.
const entry = await getEntry('toolContent', contentId(page, locale))
if (!entry) throw new Error(`Missing content ${contentId(page, locale)}`)
const { Content } = await render(entry)
const { steps = [], faq = [] } = entry.data
// The step cards' mascots, in the order of the steps (docs/design-ref/v2/assets expr-*).
const stepMascots = [normal, determined, celebrate]

const breadcrumbs = [
  { name: m.breadcrumb_home({}, { locale }), path: localePath(locale) },
  // Home › Solutions › the tool, as in the artboard.
  { name: m.nav_solutions({}, { locale }), path: shellPaths.solutions[locale] },
  { name: manifest.meta[locale].title, path: localePath(locale, manifest.meta[locale].slug) },
  ...(variant ? [{ name: meta.title, path: paths[locale] }] : []),
]
// The tool's other pages (its main page and variants), for people and crawlers alike.
const siblings = toolPages(tools).filter(
  (other) => other.tool.dir === tool.dir && other.key !== page.key,
)
// The last two words of the title are highlighted, as the canvas does ("…the size you need").
const words = meta.title.split(' ')
const markFrom = words.length > 3 ? words.length - 2 : words.length
const titleStart = words.slice(0, markFrom).join(' ')
const titleMark = words.slice(markFrom).join(' ')
// Related tools: the first three pages of the tool as cards, the rest as links.
const relatedCards = siblings.slice(0, 3)
const relatedLinks = siblings.slice(3)
const compressIcon = 'M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7'
const jsonLd = serializeJsonLd(
  toolJsonLd({
    name: meta.title,
    description: meta.description,
    url: absolute(paths[locale]),
    locale,
    category: manifest.category,
    breadcrumbs: breadcrumbs.map((item) => ({ name: item.name, url: absolute(item.path) })),
  }),
)
---

<BaseLayout locale={locale} title={`${meta.title} — Mochifile`} description={meta.description} paths={paths}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="tp">
    <section class="tp-w tp-hero" aria-labelledby="tool-title">
      <div class="tp-stack tp-g16 tp-hero-body">
        <nav aria-label={m.breadcrumb_label({}, { locale })}>
          <ol class="tp-crumbs">
            {
              breadcrumbs.map((item, index) => {
                const current = index === breadcrumbs.length - 1
                return (
                  <li>
                    {index > 0 && <span aria-hidden="true">›</span>}
                    {current ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}
                  </li>
                )
              })
            }
          </ol>
        </nav>
        {/* Everything except the interactive widget is static HTML, for SEO and no-JS visitors. */}
        <h1 id="tool-title" class="tp-h1">
          {titleStart}{titleMark && ' '}{titleMark && <span class="tp-mark">{titleMark}</span>}
        </h1>
        <p class="tp-lead">{meta.tagline}</p>
      </div>
      {/*
        client:only: the tool UI is useless without JavaScript, and server-rendering it would show
        a file input that silently ignores files picked before hydration finishes. The card
        reserves the usual height of the tool's panel (tool-reserve, measured per width), so the
        text below does not jump when the widget appears (layout shift, a Core Web Vital).
        Content added later, such as results, follows a user action and does not count as one.
      */}
      <div class="tp-panel">
        <div class="tool-reserve tp-panel-card">
          <ToolIsland
            client:only="react"
            dir={tool.dir}
            locale={locale}
            {...variant ? { initialOptions: variant.options } : {}}
          >
          </ToolIsland>
          {/* Asserted in the markup (tool-page.spec.ts): <noscript> never renders in tests. */}
          <noscript>
            <div class="tp-nojs">
              <img src={sad.src} width={sad.width} height={sad.height} alt="" />
              <p class="tp-nojs-title">{m.tool_requires_js_title({}, { locale })}</p>
              <p>{m.tool_requires_js_text({}, { locale })}</p>
            </div>
          </noscript>
        </div>
      </div>
    </section>

    {
      steps.length > 0 && (
        <section class="tp-w tp-sec tp-stack tp-g32" aria-labelledby="tool-steps">
          <div class="tp-stack tp-g12">
            <h2 id="tool-steps" class="tp-h2">{m.tool_steps_heading({}, { locale })}</h2>
            <span class="tp-uline" aria-hidden="true"><i></i><b></b><b></b></span>
          </div>
          <ol class="tp-grid" aria-labelledby="tool-steps">
            {steps.map((entry, index) => {
              const step = stepParts(entry)
              const mascot = stepMascots[index % stepMascots.length] ?? normal
              return (
                <li class="tp-card tp-step">
                  <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                  <h3 class="tp-h4">
                    <span aria-hidden="true">{index + 1}. </span>{step.title}
                  </h3>
                  {step.text && <p class="tp-small tp-muted">{step.text}</p>}
                </li>
              )
            })}
          </ol>
        </section>
      )
    }

    {
      siblings.length > 0 && (
        <section class="tp-w tp-sec-sm tp-stack tp-g32" aria-labelledby="tool-more-pages">
          <div class="tp-stack tp-g12">
            <h2 id="tool-more-pages" class="tp-h2">{m.tool_related_heading({}, { locale })}</h2>
            <span class="tp-uline" aria-hidden="true"><i></i><b></b><b></b></span>
          </div>
          <ul class="tp-grid">
            {relatedCards.map((other) => (
              <li class="tp-stack">
                <a href={other.paths[locale]} class="tp-card tp-tool">
                  <span class="tp-tool-top">
                    <span aria-hidden="true" class:list={['tp-tile', categoryTint[manifest.category]]}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={compressIcon} />
                      </svg>
                    </span>
                    <span class:list={['tp-pill', categoryTint[manifest.category]]}>{categoryLabel[manifest.category]}</span>
                  </span>
                  <span class="tp-tool-title">{other.meta[locale].title}</span>
                  <span class="tp-small tp-muted">{other.meta[locale].tagline}</span>
                  <span class="tp-open" aria-hidden="true">
                    {m.tool_open({}, { locale })}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {
            relatedLinks.length > 0 && (
              <nav aria-label={manifest.relatedPagesLabel?.[locale] ?? m.tool_more_pages_heading({}, { locale })}>
                <ul class="tp-more">
                  {relatedLinks.map((other) => (
                    <li><a href={other.paths[locale]}>{other.meta[locale].title}</a></li>
                  ))}
                </ul>
              </nav>
            )
          }
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section class="tp-w tp-sec tp-stack tp-g32" aria-labelledby="tool-faq">
          <div class="tp-stack tp-g12">
            <h2 id="tool-faq" class="tp-h2">{m.tool_faq_heading({}, { locale })}</h2>
            <span class="tp-uline" aria-hidden="true"><i></i><b></b><b></b></span>
          </div>
          {/*
            Native <details>: no script, and the answers stay in the HTML for search engines and
            in-page search. The first one starts open, as in the canvas.
          */}
          <div class="tp-faq">
            {faq.map((item) => (
              <details class="tp-faq-row">
                <summary>
                  <span>{item.question}</span>
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {/* The page's own copy (intro, how it gets there, tips), kept for readers and search engines. */}
    <section class="tp-w tp-w-mid tp-sec-sm tp-stack tp-g32">
      <article class="page-copy">
        {/* The page's description leads the copy: the lead above is the short tagline. */}
        <p class="type-body-lg">{meta.description}</p>
        <Content />
      </article>
      <section class="tp-facts" aria-labelledby="tool-facts">
        <h2 id="tool-facts" class="type-label-lg sm:type-title-sm">{m.tool_facts_heading({}, { locale })}</h2>
        {manifest.runtime === 'browser' && <p>{m.tool_privacy_browser({}, { locale })}</p>}
        <p>{m.tool_max_file_size({ maxSize }, { locale })}</p>
      </section>
    </section>
  </div>
</BaseLayout>
