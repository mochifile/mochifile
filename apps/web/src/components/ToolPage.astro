---
import { getEntry, render } from 'astro:content'
import { localePath } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import { formatBytes } from '@mochifile/tool-kit'
import BaseLayout from '../layouts/BaseLayout.astro'
import { serializeJsonLd, toolJsonLd } from '../lib/seo'
import { contentId, type ToolPageProps, toolPages, tools } from '../lib/tools'
import ToolIsland from './ToolIsland'

type Props = ToolPageProps

const { page, locale } = Astro.props
const { tool, variant, paths } = page
const { manifest } = tool
const meta = page.meta[locale]
const maxSize = formatBytes(manifest.limits.maxFileSizeBytes, locale)
const site = Astro.site ?? Astro.url
const absolute = (path: string) => new URL(path, site).href
// Each category has its identity block (design system README › Colour).
const categoryBlock = {
  image: 'bg-mango',
  media: 'bg-ube',
  pdf: 'bg-strawberry',
} as const satisfies Record<typeof manifest.category, string>

// Presence is guaranteed by assertContentComplete() in getStaticPaths.
const entry = await getEntry('toolContent', contentId(page, locale))
if (!entry) throw new Error(`Missing content ${contentId(page, locale)}`)
const { Content } = await render(entry)

const breadcrumbs = [
  { name: m.breadcrumb_home({}, { locale }), path: localePath(locale) },
  { name: manifest.meta[locale].title, path: localePath(locale, manifest.meta[locale].slug) },
  ...(variant ? [{ name: meta.title, path: paths[locale] }] : []),
]
// The tool's other pages (its main page and variants), for people and crawlers alike.
const siblings = toolPages(tools).filter(
  (other) => other.tool.dir === tool.dir && other.key !== page.key,
)
const jsonLd = serializeJsonLd(
  toolJsonLd({
    name: meta.title,
    description: meta.description,
    url: absolute(paths[locale]),
    locale,
    category: manifest.category,
    breadcrumbs: breadcrumbs.map((item) => ({ name: item.name, url: absolute(item.path) })),
  }),
)
---

<BaseLayout locale={locale} title={`${meta.title} — Mochifile`} description={meta.description} paths={paths}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  {/* Category hero block; the tool panel below overlaps its bottom edge. */}
  <div class:list={['rounded-2xl-squish-a px-5 pt-4 pb-16 text-ink-on-block sm:px-10 sm:pt-8 sm:pb-20', categoryBlock[manifest.category]]}>
  <nav aria-label={m.breadcrumb_label({}, { locale })} class="mb-2 type-caption">
    {/*
      On phones only the parent level shows (the logo already links home), on one line, a long
      name cut with "…"; the other crumbs and full names stay for screen readers. Wrapping or
      neighbours of varying width would depend on the font, and the hero must keep its layout
      when the brand font replaces the fallback, or the page would shift.
    */}
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
      {
        breadcrumbs.map((item, index) => {
          const current = index === breadcrumbs.length - 1
          const parent = index === breadcrumbs.length - 2
          return (
            <li class:list={['flex min-w-0 items-center gap-2', !parent && 'max-sm:sr-only']}>
              {index > 0 && <span aria-hidden="true" class="max-sm:hidden">›</span>}
              {current ? (
                <span aria-current="page">{item.name}</span>
              ) : (
                <a href={item.path} class="min-w-0 rounded-sm underline focus-ring max-sm:truncate">{item.name}</a>
              )}
            </li>
          )
        })
      }
    </ol>
  </nav>
  {/* Everything except the interactive widget is static HTML, for SEO and no-JS visitors. */}
  <h1 class="type-title sm:type-display-xl">{meta.title}</h1>
  {/*
    Two lines are reserved on phones (a tagline has at most 60 characters, so it never needs
    more): the fallback font can wrap it differently from Figtree, and the hero must keep its
    height when the font swaps in, or the tool panel below would shift.
  */}
  <p class="mt-2 min-h-14 max-w-reading-max type-body sm:min-h-0 sm:type-body-lg">{meta.tagline}</p>
  </div>
  {/*
    client:only: the tool UI is useless without JavaScript, and server-rendering it would show a
    file input that silently ignores files picked before hydration finishes.
  */}
  {/*
    The tool panel reserves the usual height of a tool's controls (tool-reserve, measured per
    screen width), so the text below does not jump when the client-only widget appears
    (layout shift, a Core Web Vital). Content added later, such as results, may
    still grow the page: that follows a user action and does not count as a shift.
  */}
  <div class="tool-reserve relative mx-auto -mt-10 rounded-xl-squish-a bg-surface-card p-5 sm:-mt-14 sm:p-8">
    <ToolIsland
      client:only="react"
      dir={tool.dir}
      locale={locale}
      {...variant ? { initialOptions: variant.options } : {}}
    >
    </ToolIsland>
    <noscript>
      <p class="text-center">{m.tool_requires_js({}, { locale })}</p>
    </noscript>
  </div>
  <article class="page-copy mt-16">
    {/* The page's description leads the long-form copy, keeping the hero short on phones. */}
    <p class="type-body-lg">{meta.description}</p>
    <Content />
  </article>
  <section class="mt-16 flex max-w-reading-max flex-col gap-2 rounded-lg-squish-b bg-ube-tint p-6 text-ube-ink" aria-labelledby="tool-facts">
    <h2 id="tool-facts" class="type-label-lg sm:type-title-sm">{m.tool_facts_heading({}, { locale })}</h2>
    {manifest.runtime === 'browser' && <p>{m.tool_privacy_browser({}, { locale })}</p>}
    <p>{m.tool_max_file_size({ maxSize }, { locale })}</p>
  </section>
  {
    siblings.length > 0 && (
      <nav class="mt-16" aria-labelledby="tool-more-pages">
        <h2 id="tool-more-pages" class="mb-3 type-label-lg sm:type-title-sm">
          {manifest.relatedPagesLabel?.[locale] ?? m.tool_more_pages_heading({}, { locale })}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {siblings.map((other) => (
            <li>
              <a
                href={other.paths[locale]}
                class="press inline-flex min-h-target-min items-center rounded-pill border-chip border-border-control bg-surface-card px-4 type-body-sm font-semibold hover:border-ink focus-ring"
              >
                {other.meta[locale].title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</BaseLayout>
