---
import { getEntry, render } from 'astro:content'
import { localePath } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import { formatBytes } from '@mochifile/tool-kit'
import BaseLayout from '../layouts/BaseLayout.astro'
import { serializeJsonLd, toolJsonLd } from '../lib/seo'
import { contentId, type ToolPageProps, toolPages, tools } from '../lib/tools'
import ToolIsland from './ToolIsland'

type Props = ToolPageProps

const { page, locale } = Astro.props
const { tool, variant, paths } = page
const { manifest } = tool
const meta = page.meta[locale]
const maxSize = formatBytes(manifest.limits.maxFileSizeBytes, locale)
const site = Astro.site ?? Astro.url
const absolute = (path: string) => new URL(path, site).href

// Presence is guaranteed by assertContentComplete() in getStaticPaths.
const entry = await getEntry('toolContent', contentId(page, locale))
if (!entry) throw new Error(`Missing content ${contentId(page, locale)}`)
const { Content } = await render(entry)

const breadcrumbs = [
  { name: m.breadcrumb_home({}, { locale }), path: localePath(locale) },
  { name: manifest.meta[locale].title, path: localePath(locale, manifest.meta[locale].slug) },
  ...(variant ? [{ name: meta.title, path: paths[locale] }] : []),
]
// The tool's other pages (its main page and variants), for people and crawlers alike.
const siblings = toolPages(tools).filter(
  (other) => other.tool.dir === tool.dir && other.key !== page.key,
)
const jsonLd = serializeJsonLd(
  toolJsonLd({
    name: meta.title,
    description: meta.description,
    url: absolute(paths[locale]),
    locale,
    category: manifest.category,
    breadcrumbs: breadcrumbs.map((item) => ({ name: item.name, url: absolute(item.path) })),
  }),
)
---

<BaseLayout locale={locale} title={`${meta.title} — Mochifile`} description={meta.description} paths={paths}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <nav aria-label={m.breadcrumb_label({}, { locale })} class="mb-6 type-body-sm text-ink-muted">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
      {
        breadcrumbs.map((item, index) => {
          const current = index === breadcrumbs.length - 1
          return (
            <li class="flex items-center gap-2">
              {index > 0 && <span aria-hidden="true">›</span>}
              {current ? (
                <span aria-current="page" class="text-ink">{item.name}</span>
              ) : (
                <a href={item.path} class="underline hover:underline">{item.name}</a>
              )}
            </li>
          )
        })
      }
    </ol>
  </nav>
  {/* Everything except the interactive widget is static HTML, for SEO and no-JS visitors. */}
  <h1 class="mb-2 type-display-lg">{meta.title}</h1>
  <p class="mb-8 text-ink-muted">{meta.description}</p>
  {/*
    client:only: the tool UI is useless without JavaScript, and server-rendering it would show a
    file input that silently ignores files picked before hydration finishes.
  */}
  {/*
    Reserves the usual height of a tool's controls (options and file picker, measured at
    390–532 px), so the text below does not jump when the client-only widget replaces its
    placeholder (layout shift, a Core Web Vital). Content added later, such as results, may
    still grow the page: that follows a user action and does not count as a shift.
  */}
  <div class="tool-reserve">
    <ToolIsland
      client:only="react"
      dir={tool.dir}
      locale={locale}
      {...variant ? { initialOptions: variant.options } : {}}
    >
      <div slot="fallback" class="tool-reserve animate-pulse rounded-lg bg-surface-card"></div>
    </ToolIsland>
  </div>
  <noscript>
    <p class="rounded-lg border border-line bg-surface-card p-6 text-center">
      {m.tool_requires_js({}, { locale })}
    </p>
  </noscript>
  <article class="page-copy mt-16">
    <Content />
  </article>
  <section class="mt-16 flex flex-col gap-2 rounded-lg border border-line bg-surface-card p-6" aria-labelledby="tool-facts">
    <h2 id="tool-facts" class="type-title-sm">{m.tool_facts_heading({}, { locale })}</h2>
    {manifest.runtime === 'browser' && <p>{m.tool_privacy_browser({}, { locale })}</p>}
    <p>{m.tool_max_file_size({ maxSize }, { locale })}</p>
  </section>
  {
    siblings.length > 0 && (
      <nav class="mt-16" aria-labelledby="tool-more-pages">
        <h2 id="tool-more-pages" class="mb-3 type-title-sm">
          {manifest.relatedPagesLabel?.[locale] ?? m.tool_more_pages_heading({}, { locale })}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {siblings.map((other) => (
            <li>
              <a
                href={other.paths[locale]}
                class="inline-flex min-h-target-min items-center rounded-pill border border-border-control px-4 hover:border-ink hover:underline"
              >
                {other.meta[locale].title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</BaseLayout>
