---
/**
 * The site header with its "Skip to content" link, the language menu and the phone menu
 * (V2 canvas: MFHeader, MFMenuMobile; ADR 0023, ADR 0030).
 *
 * From 1024 px the header shows Solutions · Guides · Docs · Pricing · Sign in · Get started and
 * a language button. Under 1024 px they move into a menu opened by a native button and the
 * declarative Popover API: no JavaScript, so Enter, Space, Escape, closing by tapping outside
 * and returning focus to the button all come from the browser. While the menu is open the rest
 * of the page steps out of view (global.css), so the next Tab after the last item never reaches
 * content hidden beneath it. Browsers without the Popover API get the menu's content in the
 * page flow instead of a button, and no language button (the footer lists the languages too).
 *
 * Every control the canvas draws is here. A destination that does not exist yet is a
 * `ComingSoon` control, not a link, and a language with no pages is listed the same way; see
 * lib/site-nav.ts.
 */
import { type Locale, localePath, localeTags } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import mascotHappy from '../assets/mascot/sheet-happy-700.png'
import { accountLinks, mainLinks, shellLanguages } from '../lib/site-nav'
import ArrowRight from './ArrowRight.astro'
import ComingSoon from './ComingSoon.astro'
import ComingSoonNotice from './ComingSoonNotice.astro'
import Logo from './Logo.astro'

interface Props {
  locale: Locale
  /** Path of this page in every locale. */
  paths: Record<Locale, string>
}

const { locale, paths } = Astro.props
const links = mainLinks(locale)
const { signIn, getStarted } = accountLinks(locale)
const languages = shellLanguages.map((language) => ({
  ...language,
  href: language.locale ? paths[language.locale] : undefined,
  hreflang: language.locale ? localeTags[language.locale] : undefined,
  current: language.locale === locale,
}))
const currentLanguage = languages.find((language) => language.current)

const navItem =
  'press inline-flex min-h-target-min items-center rounded-pill px-3 type-nav hover:bg-accent-soft focus-ring aria-[current=page]:bg-accent-soft aria-[current=page]:text-ube-ink'
const primaryPill =
  'press inline-flex min-h-target-min items-center justify-center rounded-pill bg-action px-pill-sm type-button-sm text-action-ink shadow-action focus-ring'
const menuRow =
  'press flex min-h-menu-row w-full items-center justify-between border-hairline border-x-0 border-t-0 border-card-line px-1 text-left type-menu-link focus-ring'
const bigPill =
  'press inline-flex min-h-target-lg w-full items-center justify-center rounded-pill px-6 type-button-lg focus-ring'
const chip =
  'press inline-flex min-h-target-min items-center rounded-pill border-hairline border-card-line bg-surface-card px-chip type-chip shadow-chip focus-ring aria-[current=true]:border-ink aria-[current=true]:bg-action aria-[current=true]:text-action-ink'
const languageItem =
  'press flex min-h-target-min w-full items-center justify-between gap-3 rounded-small px-3 text-left type-nav hover:bg-accent-soft focus-ring aria-[current=true]:bg-accent-soft aria-[current=true]:text-ube-ink'
---

{/*
  The page's first Tab stop; out of view until focused, then above the logo. Its padding is
  under `focus:` because `not-sr-only` resets padding.
*/}
<a
  href="#content"
  data-skip-link
  class="sr-only rounded-pill bg-action font-medium text-action-ink focus-ring focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:inline-flex focus:min-h-target-min focus:items-center focus:px-4"
>
  {m.skip_to_content({}, { locale })}
</a>
<header class="group/header relative z-10">
  <div class="mx-auto flex min-h-site-header max-w-site-max items-center justify-between gap-6 px-5 sm:px-8">
    <Logo href={localePath(locale)} />
    <div class="flex items-center gap-3">
      <nav aria-label={m.nav_main({}, { locale })} data-main-nav class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            links.map((link) => (
              <li>
                {link.href ? (
                  <a href={link.href} class={navItem}>
                    {link.label}
                  </a>
                ) : (
                  <ComingSoon locale={locale} class={navItem} data-shell-link={link.key}>
                    {link.label}
                  </ComingSoon>
                )}
              </li>
            ))
          }
          <li class="ml-2">
            <ComingSoon
              locale={locale}
              class:list={[navItem, 'text-ink-muted']}
              data-shell-link={signIn.key}
            >
              {signIn.label}
            </ComingSoon>
          </li>
          <li class="ml-1">
            <ComingSoon locale={locale} class={primaryPill} data-shell-link={getStarted.key}>
              {getStarted.label}
            </ComingSoon>
          </li>
        </ul>
      </nav>
      {/*
        Language button (desktop): opens a list of the six languages in their own names. English
        and Portuguese are links to this page's alternate (ADR 0007), so no script decides
        anything; the others are "Coming soon". Under 1024 px the same list is in the menu.
      */}
      <button
        type="button"
        popovertarget="site-language"
        aria-label={m.nav_language_current({ language: currentLanguage?.name ?? '' }, { locale })}
        data-language-button
        class="press hidden min-h-target-min items-center justify-center gap-2 rounded-pill border-hairline border-card-line bg-surface-card/60 px-3 type-button-sm text-ink focus-ring with-popover:lg:inline-flex"
      >
        {/* Line icons on the 24px grid, 2px stroke (README › Iconography). */}
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18"></path>
          <path d="M12 3c3 3 3 15 0 18-3-3-3-15 0-18"></path>
        </svg>
        <span lang={currentLanguage?.tag}>{currentLanguage?.name}</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </button>
      {/* The browser exposes its open and closed state (aria-expanded) from `popovertarget`. */}
      <button
        type="button"
        popovertarget="site-menu"
        aria-label={m.nav_menu({}, { locale })}
        class="press hidden size-target-min items-center justify-center rounded-small border-hairline border-card-line bg-surface-card text-ink shadow-card focus-ring with-popover:max-lg:inline-flex"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-button-icon group-has-[[data-site-menu]:popover-open]/header:hidden"
        >
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden size-button-icon group-has-[[data-site-menu]:popover-open]/header:block"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
  <div
    id="site-language"
    popover
    data-language-menu
    class="w-language-menu rounded-card border-hairline border-card-line bg-surface-card p-2 text-ink shadow-lift max-lg:hidden"
  >
    <ul aria-label={m.nav_language({}, { locale })} class="flex flex-col">
      {
        languages.map((language) => (
          <li>
            {language.href ? (
              <a
                href={language.href}
                hreflang={language.hreflang}
                lang={language.tag}
                aria-current={language.current ? 'true' : undefined}
                data-language-switch
                class={languageItem}
              >
                {language.name}
                {language.current && (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 shrink-0"
                  >
                    <path d="M5 12l5 5 9-10"></path>
                  </svg>
                )}
              </a>
            ) : (
              <ComingSoon
                locale={locale}
                notice="coming-soon-language"
                class={languageItem}
                data-shell-link={`language-${language.tag}`}
              >
                <span lang={language.tag}>{language.name}</span>
              </ComingSoon>
            )}
          </li>
        ))
      }
    </ul>
    <ComingSoonNotice locale={locale} id="coming-soon-language" />
  </div>
  {/*
    Right after the button in the DOM, so the next Tab enters the menu. With the Popover API it
    sits in the top layer from the header row down to the bottom of the screen (the browser's
    `bottom: 0`, kept on purpose): a press on its blank part stays inside it. A menu only as
    tall as its links closed on a tap below them, and the tap's click then reached the page
    reappearing beneath (it opened the file picker). Without the API, it sits in the page flow.
  */}
  <nav
    id="site-menu"
    popover
    data-site-menu
    aria-label={m.nav_menu({}, { locale })}
    class="border-0 bg-surface-page p-0 text-ink lg:hidden with-popover:absolute with-popover:inset-x-0 with-popover:top-(--site-header-height) with-popover:m-0 with-popover:h-auto with-popover:w-full"
  >
    <div class="mx-auto flex max-w-site-max flex-col px-5 pt-3 pb-8 sm:px-8">
      <ul>
        {
          links.map((link) => (
            <li>
              {link.href ? (
                <a href={link.href} class={menuRow}>
                  {link.label}
                  <ArrowRight />
                </a>
              ) : (
                <ComingSoon
                  locale={locale}
                  notice="coming-soon-menu"
                  class={menuRow}
                  data-shell-link={link.key}
                >
                  {link.label}
                  <ArrowRight />
                </ComingSoon>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3">
        <ComingSoon
          locale={locale}
          notice="coming-soon-menu"
          class:list={[bigPill, 'bg-action text-action-ink shadow-action']}
          data-shell-link={getStarted.key}
        >
          {getStarted.label}
        </ComingSoon>
        <ComingSoon
          locale={locale}
          notice="coming-soon-menu"
          class:list={[bigPill, 'border-hairline border-card-line bg-surface-card text-ink shadow-card']}
          data-shell-link={signIn.key}
        >
          {signIn.label}
        </ComingSoon>
      </div>
      <div class="mt-8 flex flex-col gap-2">
        <p id="site-menu-language" class="type-eyebrow text-accent uppercase">
          {m.nav_language({}, { locale })}
        </p>
        <ul aria-labelledby="site-menu-language" class="flex flex-wrap gap-2">
          {
            languages.map((language) => (
              <li>
                {language.href ? (
                  <a
                    href={language.href}
                    hreflang={language.hreflang}
                    lang={language.tag}
                    aria-current={language.current ? 'true' : undefined}
                    data-language-switch
                    class={chip}
                  >
                    {language.name}
                  </a>
                ) : (
                  <ComingSoon
                    locale={locale}
                    notice="coming-soon-menu"
                    class={chip}
                    data-shell-link={`language-${language.tag}`}
                  >
                    <span lang={language.tag}>{language.name}</span>
                  </ComingSoon>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      {/* The approved "happy" mascot on its green block; decorative, once, never over a control. */}
      <img
        src={mascotHappy.src}
        alt=""
        width={700}
        height={414}
        loading="lazy"
        decoding="async"
        class="mt-8 h-auto w-full rounded-mascot"
      />
    </div>
    <ComingSoonNotice locale={locale} id="coming-soon-menu" />
  </nav>
</header>
