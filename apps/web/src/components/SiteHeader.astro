---
/**
 * The site header with its "Skip to content" link and the phone menu (V2 canvas: MFHeader,
 * MFMenuMobile; ADR 0023, ADR 0030).
 *
 * From 1024 px the header shows Solutions · Guides · Docs · Pricing · Sign in · Get started.
 * Under 1024 px they move into a menu opened by a native button and the declarative Popover API:
 * no JavaScript, so Enter, Space, Escape, closing by tapping outside and returning focus to the
 * button all come from the browser. While the menu is open the rest of the page steps out of view
 * (global.css), so the next Tab after the last item never reaches content hidden beneath it.
 * Browsers without the Popover API get the menu's content in the page flow instead of a button.
 *
 * The language selector lives only in the footer (ADR 0030): neither the header nor the menu has
 * one. A destination that does not exist yet is a `ComingSoon` control, not a link; see
 * lib/site-nav.ts.
 */
import { type Locale, localePath } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import { illustration } from '../lib/illustrations'
import { accountLinks, isCurrent, mainLinks } from '../lib/site-nav'
import ArrowRight from './ArrowRight.astro'
import ComingSoon from './ComingSoon.astro'
import ComingSoonNotice from './ComingSoonNotice.astro'
import Logo from './Logo.astro'

interface Props {
  locale: Locale
  /** Path of this page in every locale. */
  paths: Record<Locale, string>
}

const { locale, paths } = Astro.props
const links = mainLinks(locale)
const { signIn, getStarted } = accountLinks(locale)

const navItem =
  'press inline-flex min-h-target-min items-center rounded-pill px-3 type-nav hover:bg-accent-soft focus-ring aria-[current=page]:bg-accent-soft aria-[current=page]:text-ube-ink'
const primaryPill =
  'press inline-flex min-h-target-min items-center justify-center rounded-pill bg-action px-pill-sm type-button-sm text-action-ink shadow-action focus-ring'
const menuRow =
  'press flex min-h-menu-row w-full items-center justify-between border-hairline border-x-0 border-t-0 border-card-line px-1 text-left type-menu-link focus-ring'
const bigPill =
  'press inline-flex min-h-target-lg w-full items-center justify-center rounded-pill px-6 type-button-lg focus-ring'
---

{/*
  The page's first Tab stop; out of view until focused, then above the logo. Its padding is
  under `focus:` because `not-sr-only` resets padding.
*/}
<a
  href="#content"
  data-skip-link
  class="sr-only rounded-pill bg-action font-medium text-action-ink focus-ring focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:inline-flex focus:min-h-target-min focus:items-center focus:px-4"
>
  {m.skip_to_content({}, { locale })}
</a>
<header class="group/header relative z-10">
  <div class="mx-auto flex min-h-site-header max-w-site-max items-center justify-between gap-6 px-5 sm:px-8">
    <Logo href={localePath(locale)} />
    <div class="flex items-center gap-3">
      <nav aria-label={m.nav_main({}, { locale })} data-main-nav class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            links.map((link) => (
              <li>
                {link.href ? (
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href, paths[locale]) ? 'page' : undefined}
                    class={navItem}
                    data-shell-link={link.key}
                  >
                    {link.label}
                  </a>
                ) : (
                  <ComingSoon locale={locale} class={navItem} data-shell-link={link.key}>
                    {link.label}
                  </ComingSoon>
                )}
              </li>
            ))
          }
          <li class="ml-2">
            {signIn.href ? (
              <a
                href={signIn.href}
                aria-current={isCurrent(signIn.href, paths[locale]) ? 'page' : undefined}
                class:list={[navItem, 'text-ink-muted']}
                data-shell-link={signIn.key}
              >
                {signIn.label}
              </a>
            ) : (
              <ComingSoon
                locale={locale}
                class:list={[navItem, 'text-ink-muted']}
                data-shell-link={signIn.key}
              >
                {signIn.label}
              </ComingSoon>
            )}
          </li>
          <li class="ml-1">
            {getStarted.href ? (
              <a href={getStarted.href} class={primaryPill} data-shell-link={getStarted.key}>
                {getStarted.label}
              </a>
            ) : (
              <ComingSoon locale={locale} class={primaryPill} data-shell-link={getStarted.key}>
                {getStarted.label}
              </ComingSoon>
            )}
          </li>
        </ul>
      </nav>
      {/* The browser exposes its open and closed state (aria-expanded) from `popovertarget`. */}
      <button
        type="button"
        popovertarget="site-menu"
        aria-label={m.nav_menu({}, { locale })}
        class="press hidden size-target-min items-center justify-center rounded-small border-hairline border-card-line bg-surface-card text-ink shadow-card focus-ring with-popover:max-lg:inline-flex"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-button-icon group-has-[[data-site-menu]:popover-open]/header:hidden"
        >
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden size-button-icon group-has-[[data-site-menu]:popover-open]/header:block"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
  {/*
    Right after the button in the DOM, so the next Tab enters the menu. With the Popover API it
    sits in the top layer from the header row down to the bottom of the screen (the browser's
    `bottom: 0`, kept on purpose): a press on its blank part stays inside it. A menu only as
    tall as its links closed on a tap below them, and the tap's click then reached the page
    reappearing beneath (it opened the file picker). Without the API, it sits in the page flow.
  */}
  <nav
    id="site-menu"
    popover
    data-site-menu
    aria-label={m.nav_menu({}, { locale })}
    class="border-0 bg-surface-page p-0 text-ink lg:hidden with-popover:absolute with-popover:inset-x-0 with-popover:top-(--site-header-height) with-popover:m-0 with-popover:h-auto with-popover:w-full"
  >
    <div class="mx-auto flex max-w-site-max flex-col px-5 pt-3 pb-8 sm:px-8">
      <ul>
        {
          links.map((link) => (
            <li>
              {link.href ? (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href, paths[locale]) ? 'page' : undefined}
                  class={menuRow}
                  data-shell-link={link.key}
                >
                  {link.label}
                  <ArrowRight />
                </a>
              ) : (
                <ComingSoon
                  locale={locale}
                  notice="coming-soon-menu"
                  class={menuRow}
                  data-shell-link={link.key}
                >
                  {link.label}
                  <ArrowRight />
                </ComingSoon>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3">
        {
          [
            { link: getStarted, tone: 'bg-action text-action-ink shadow-action' },
            {
              link: signIn,
              tone: 'border-hairline border-card-line bg-surface-card text-ink shadow-card',
            },
          ].map(({ link, tone }) =>
            link.href ? (
              <a href={link.href} class:list={[bigPill, tone]} data-shell-link={link.key}>
                {link.label}
              </a>
            ) : (
              <ComingSoon
                locale={locale}
                notice="coming-soon-menu"
                class:list={[bigPill, tone]}
                data-shell-link={link.key}
              >
                {link.label}
              </ComingSoon>
            ),
          )
        }
      </div>
      {/* The approved "happy" mascot on its green block; decorative, once, never over a control. */}
      <img
        {...illustration('sheet-happy', 'calc(100vw - 32px)')}
        alt=""
        loading="lazy"
        decoding="async"
        class="mt-8 h-auto w-full rounded-mascot"
      />
    </div>
    <ComingSoonNotice locale={locale} id="coming-soon-menu" />
  </nav>
</header>
