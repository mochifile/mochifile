---
/**
 * The site header with its "Skip to content" link and the phone menu (ADR 0023).
 *
 * From 1024 px the tool links sit in the header. Below 1024 px they move to a menu opened by a
 * native button and the declarative Popover API: no JavaScript, so Enter, Space, Escape, closing
 * by tapping outside and returning focus to the button all come from the browser. While the menu
 * is open the rest of the page steps out of view (global.css), so the next Tab after the last
 * item never reaches content hidden beneath it. Browsers without the Popover API get the menu's
 * links in the page flow instead of a button.
 *
 * Every destination comes from the tool registry; nothing unreleased is listed.
 */
import { type Locale, localeNames, localePath, locales, localeTags } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import { toolPaths, tools } from '../lib/tools'
import Logo from './Logo.astro'

interface Props {
  locale: Locale
  /** Path of this page in every locale. */
  paths: Record<Locale, string>
}

const { locale, paths } = Astro.props
const toolLinks = tools.map(({ manifest }) => ({
  href: toolPaths(manifest)[locale],
  title: manifest.meta[locale].title,
  tagline: manifest.meta[locale].tagline,
}))
const otherLocales = locales.filter((target) => target !== locale)
const current = (href: string) => (href === paths[locale] ? 'page' : undefined)
---

{/*
  The page's first Tab stop; out of view until focused, then above the logo. Its padding is
  under `focus:` because `not-sr-only` resets padding.
*/}
<a
  href="#content"
  data-skip-link
  class="sr-only rounded-pill bg-action font-medium text-action-ink focus-ring focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:inline-flex focus:min-h-target-min focus:items-center focus:px-4"
>
  {m.skip_to_content({}, { locale })}
</a>
<header class="group/header">
  {/*
    The gap keeps the logo's clear space (0.715 × its height: 15px, then 24px from 600px). Under
    1024 px the row is exactly `--site-header-height` tall (its tallest items are `target-min`),
    which places the menu and the phone language suggestion right below it.
  */}
  <div class="mx-auto flex max-w-content-max items-center gap-4 px-4 py-2 sm:gap-6 lg:py-5">
    <Logo href={localePath(locale)} />
    {/*
      Each tool link starts its own equal cell between the logo and the language links, all of
      fixed width, and stays on one line, so neither its position nor the header's height
      depends on how wide a font draws the titles: right-aligned, the links moved 7 px when
      Figtree replaced its fallback, and a wrapping title made the header 4 px taller (layout
      shifts). A title wider than its cell (only with several tools on a narrow screen) is cut
      with "…" on screen; its accessible name stays whole.
    */}
    <nav aria-label={m.nav_main({}, { locale })} class="hidden min-w-0 flex-1 lg:block">
      <ul class="flex gap-1 type-body-sm font-semibold">
        {
          toolLinks.map((link) => (
            <li class="min-w-0 flex-1">
              <a
                href={link.href}
                aria-current={current(link.href)}
                class="press inline-flex min-h-target-min max-w-full items-center rounded-pill border-chip border-transparent px-3 hover:border-border-control focus-ring aria-[current=page]:border-ink"
              >
                <span class="truncate">{link.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2 lg:gap-6">
      <nav aria-label={m.nav_language({}, { locale })}>
        <ul class="flex gap-1 type-body-sm font-semibold">
          {/* Fixed-width cells: see --spacing-language-link. */}
          {
            locales.map((target) => (
              // Under 600 px only the other languages show, so the menu button fits at 360 px.
              <li class:list={[target === locale && 'max-sm:hidden']}>
                <a
                  href={paths[target]}
                  hreflang={localeTags[target]}
                  lang={localeTags[target]}
                  data-language-switch
                  aria-current={target === locale ? 'true' : undefined}
                  class:list={[
                    'press inline-flex min-h-target-min w-language-link items-center justify-center rounded-pill border-chip px-1 focus-ring',
                    target === locale
                      ? 'border-ink font-bold'
                      : 'border-transparent hover:border-border-control',
                  ]}
                >
                  {localeNames[target]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* The browser exposes its open and closed state (aria-expanded) from `popovertarget`. */}
      <button
        type="button"
        popovertarget="site-menu"
        aria-label={m.nav_menu({}, { locale })}
        class="press hidden size-target-min items-center justify-center rounded-pill border-chip border-border-control bg-surface-page text-ink hover:border-ink focus-ring group-has-[[data-site-menu]:popover-open]/header:border-ink group-has-[[data-site-menu]:popover-open]/header:bg-surface-card with-popover:max-lg:inline-flex"
      >
        {/* Line icons on the 24px grid, 2px stroke (README › Iconography). */}
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="size-button-icon group-has-[[data-site-menu]:popover-open]/header:hidden"
        >
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="hidden size-button-icon group-has-[[data-site-menu]:popover-open]/header:block"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
  {/*
    Right after the button in the DOM, so the next Tab enters the menu. With the Popover API it
    sits in the top layer from the header row down to the bottom of the screen (the browser's
    `bottom: 0`, kept on purpose): a press on its blank part stays inside it. A menu only as
    tall as its links closed on a tap below them, and the tap's click then reached the page
    reappearing beneath (it opened the file picker). Without the API, it sits in the page flow.
  */}
  <nav
    id="site-menu"
    popover
    data-site-menu
    aria-label={m.nav_menu({}, { locale })}
    class="border-0 bg-surface-page p-0 text-ink lg:hidden with-popover:absolute with-popover:inset-x-0 with-popover:top-(--site-header-height) with-popover:m-0 with-popover:h-auto with-popover:w-full"
  >
    <div class="mx-auto flex max-w-content-max flex-col gap-6 px-4 pt-2 pb-10">
      <div class="flex flex-col gap-3">
        <p id="site-menu-tools" class="type-label-lg">{m.nav_tools({}, { locale })}</p>
        <ul aria-labelledby="site-menu-tools" class="flex flex-col rounded-lg-squish-a bg-surface-card p-2">
          {
            toolLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current(link.href)}
                  class="group/link flex min-h-target-primary flex-col justify-center rounded-sm px-3 py-2 focus-ring"
                >
                  <span class="font-bold group-hover/link:underline">{link.title}</span>
                  <span class="type-body-sm text-ink-muted">{link.tagline}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <ul aria-label={m.nav_language({}, { locale })} class="flex flex-col rounded-lg-squish-b bg-surface-card p-2">
        {
          otherLocales.map((target) => (
            <li>
              <a
                href={paths[target]}
                hreflang={localeTags[target]}
                lang={localeTags[target]}
                data-language-switch
                class="flex min-h-target-primary items-center rounded-sm px-3 font-semibold hover:underline focus-ring"
              >
                {localeNames[target]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
