---
/**
 * The white band that closes the guides: a free-tool pill, a heading, a line, the way to the
 * tool and a mascot on its own block (MFGuides, MFGuide). The mascot sheet already carries its
 * block colour; it is decoration.
 */
import { illustration } from '../lib/illustrations'

interface Props {
  pill: string
  heading: string
  text: string
  action: string
  href: string
  mascot: 'squish' | 'happy'
}

const { pill, heading, text, action, href, mascot } = Astro.props
---

<section aria-label={heading} class="grid items-center gap-8 rounded-card border-hairline border-card-line bg-surface-card shadow-card p-6 sm:p-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:p-14">
  <div class="flex flex-col items-start gap-4">
    <span class="inline-flex min-h-6 items-center rounded-pill bg-matcha-tint px-3 type-pill text-matcha-ink uppercase">{pill}</span>
    <h2 class="type-section-title-sm text-balance sm:type-section-title">{heading}</h2>
    <p class="type-body text-ink-muted sm:type-body-lg">{text}</p>
    <a href={href} class="press inline-flex min-h-target-primary items-center justify-center gap-2 rounded-pill bg-action px-6 type-label-lg text-action-ink focus-ring">
      {action}
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-button-icon"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
  <img
    {...illustration(`sheet-${mascot}`, '(min-width: 1024px) 336px, (min-width: 641px) calc(100vw - 114px), calc(100vw - 82px)')}
    alt=""
    loading="lazy"
    decoding="async"
    class="h-auto w-full rounded-mascot"
  />
</section>
