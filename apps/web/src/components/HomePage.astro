---
/**
 * The home page, Mochifile V2 (docs/design-ref/v2, artboard MFHome): hero with the Ask prompt and
 * the CLI install box, "Works where you work", Ask examples, privacy card, FAQ and the closing
 * call. Visual first: every designed part is on the page, and each one that does not work yet
 * says so when it is used (a native popover, no script). Static HTML: no script beyond the
 * site-wide language suggestion.
 *
 * What works today leads somewhere real, taken from the tool registry: the compressor, and its
 * 50 KB page. Nothing here simulates processing or a result. Destinations that are not published
 * yet are `undefined` below; flip them to real paths as the pages land.
 */
import type { Locale } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import BaseLayout from '../layouts/BaseLayout.astro'
import { askPaths } from '../lib/ask'
import { startCard } from '../lib/home.ts'
import { pagePaths } from '../lib/pages'
import { samePathInAllLocales } from '../lib/seo.ts'
import { tools } from '../lib/tools.ts'
import HomeAsk from './home/HomeAsk.astro'
import HomeCta from './home/HomeCta.astro'
import HomeFaq from './home/HomeFaq.astro'
import HomeHero from './home/HomeHero.astro'
import HomeHub from './home/HomeHub.astro'
import HomePrivacy from './home/HomePrivacy.astro'
import SoonPopover from './home/SoonPopover.astro'
import '../styles/home.css'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const start = startCard(tools, locale)
const toolHref = start?.href
const under50Href = start?.featured.find((size) => size.bytes === 50_000)?.href
// Where the privacy card's "How it is built" and the prompt's "Open Ask Mochifile" lead.
const architectureHref: string | undefined = pagePaths('architecture')[locale]
const askHref: string | undefined = askPaths[locale]
---

<BaseLayout
  locale={locale}
  title={m.hv2_meta_title({}, { locale })}
  description={m.hv2_meta_description({}, { locale })}
  paths={samePathInAllLocales('/')}
>
  <div class="hv2">
    <HomeHero locale={locale} under50Href={under50Href} askHref={askHref} />
    <HomeHub locale={locale} />
    <HomeAsk locale={locale} under50Href={under50Href} />
    <HomePrivacy locale={locale} builtHref={architectureHref} />
    <HomeFaq locale={locale} />
    <HomeCta locale={locale} toolHref={toolHref} />
    <SoonPopover locale={locale} toolHref={toolHref ?? '/'} />
  </div>
</BaseLayout>
