---
import { type Locale, localePath } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import BaseLayout from '../layouts/BaseLayout.astro'
import { samePathInAllLocales } from '../lib/seo'
import { toolPaths, tools } from '../lib/tools'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<BaseLayout
  locale={locale}
  title={m.home_title({}, { locale })}
  description={m.home_description({}, { locale })}
  paths={samePathInAllLocales('/')}
>
  {/*
    Left-aligned: centred lines move sideways when Figtree replaces its fallback, a layout
    shift (seen on Linux). The home page redesign comes later.
  */}
  <section class="flex flex-col gap-4 py-8">
    <h1 class="type-display-lg sm:type-display-xl">{m.home_heading({}, { locale })}</h1>
    <p class="max-w-reading-max type-body-lg text-ink-muted">{m.home_lead({}, { locale })}</p>
  </section>
  {
    tools.length > 0 ? (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map(({ manifest }) => (
          <li class="flex h-full flex-col gap-3 rounded-lg border border-line bg-surface-card p-5 has-[a.tool-link:hover]:border-ink">
            <a href={toolPaths(manifest)[locale]} class="tool-link">
              <span class="font-semibold">{manifest.meta[locale].title}</span>
              <span class="mt-1 block type-body-sm text-ink-muted">
                {manifest.meta[locale].description}
              </span>
            </a>
            {/* Variant pages (e.g. a target size) as shortcuts, also giving crawlers a path. One per row: side by side, how many fit changes when the fonts swap, a layout shift. */}
            {manifest.variants && manifest.variants.length > 0 && (
              <ul class="mt-auto flex flex-col items-start gap-2 type-body-sm" aria-label={manifest.meta[locale].title}>
                {manifest.variants.map((variant) => (
                  <li>
                    <a
                      href={localePath(locale, variant.meta[locale].slug)}
                      class="inline-flex min-h-target-min items-center rounded-pill border border-border-control px-3 hover:border-ink hover:underline"
                    >
                      {variant.meta[locale].title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-ink-muted">{m.home_coming_soon({}, { locale })}</p>
    )
  }
</BaseLayout>
