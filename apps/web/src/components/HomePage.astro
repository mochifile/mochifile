---
import { type Locale, localePath } from '@mochifile/i18n'
import { m } from '@mochifile/i18n/messages'
import BaseLayout from '../layouts/BaseLayout.astro'
import { samePathInAllLocales } from '../lib/seo'
import { toolPaths, tools } from '../lib/tools'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<BaseLayout
  locale={locale}
  title={m.home_title({}, { locale })}
  description={m.home_description({}, { locale })}
  paths={samePathInAllLocales('/')}
>
  <section class="flex flex-col gap-4 py-8 text-center">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{m.home_heading({}, { locale })}</h1>
    <p class="mx-auto max-w-2xl text-lg text-text-muted">{m.home_lead({}, { locale })}</p>
  </section>
  {
    tools.length > 0 ? (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map(({ manifest }) => (
          <li class="flex h-full flex-col gap-3 rounded-card border border-border bg-surface-raised p-5 has-[a.tool-link:hover]:border-accent">
            <a href={toolPaths(manifest)[locale]} class="tool-link">
              <span class="font-semibold">{manifest.meta[locale].title}</span>
              <span class="mt-1 block text-sm text-text-muted">
                {manifest.meta[locale].description}
              </span>
            </a>
            {/* Variant pages (e.g. a target size) as shortcuts, also giving crawlers a path. */}
            {manifest.variants && manifest.variants.length > 0 && (
              <ul class="mt-auto flex flex-wrap gap-2 text-sm" aria-label={manifest.meta[locale].title}>
                {manifest.variants.map((variant) => (
                  <li>
                    <a
                      href={localePath(locale, variant.meta[locale].slug)}
                      class="inline-flex min-h-11 items-center rounded-control border border-border px-3 hover:border-accent hover:text-accent"
                    >
                      {variant.meta[locale].title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center text-text-muted">{m.home_coming_soon({}, { locale })}</p>
    )
  }
</BaseLayout>
