---
import { Font } from 'astro:assets'
import { type Locale, localeTags } from '@mochifile/i18n'
import LanguageSuggestion from '../components/LanguageSuggestion.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { buildAlternates } from '../lib/seo'
import '../styles/global.css'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Path of this page in every locale. */
  paths: Record<Locale, string>
  /** For pages that must not be indexed (e.g. 404): no canonical, no hreflang. */
  noindex?: boolean
}

const { locale, title, description, paths, noindex = false } = Astro.props
const site = Astro.site ?? Astro.url
const canonical = new URL(paths[locale], site).href
const alternates = buildAlternates(paths, site)
---

<!doctype html>
<html lang={localeTags[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {/* Only the display face is preloaded: it draws the H1, the largest text on tool pages. */}
    <Font cssVariable="--font-fredoka" preload />
    <Font cssVariable="--font-figtree" />
    {/* The final logo's icons (docs/design-system/assets/Logos): SVG for modern browsers,
        pixel-drawn PNGs for the rest, the app icon on a mango square. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mochifile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTags[locale]} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body class="flex min-h-dvh flex-col bg-surface-page text-ink antialiased">
    <SiteHeader locale={locale} paths={paths} />
    {/* Pages without alternates (e.g. 404) have nothing to suggest. */}
    {!noindex && <LanguageSuggestion locale={locale} paths={paths} />}
    {/*
      The skip link's target: `tabindex="-1"` moves focus here in every engine without adding a Tab stop.
      From 1024 px the first block sits `space-2` (8 px) under the header, as in every desktop artboard.
    */}
    <main id="content" tabindex="-1" class="mx-auto w-full max-w-content-max flex-1 px-4 pt-4 pb-16 outline-none sm:pt-6 lg:pt-2">
      <slot />
    </main>
    <SiteFooter locale={locale} paths={paths} />
  </body>
</html>
