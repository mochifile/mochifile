---
import { getCollection } from 'astro:content'
import ToolPage from '../components/ToolPage.astro'
import {
  assertContentComplete,
  buildToolRoutes,
  type ToolPageProps,
  toolPages,
  tools,
} from '../lib/tools'

export async function getStaticPaths() {
  const content = await getCollection('toolContent')
  assertContentComplete(toolPages(tools), new Set(content.map((entry) => entry.id)))
  return buildToolRoutes(tools, 'en')
}

const props = Astro.props as ToolPageProps
---

<ToolPage {...props} />
