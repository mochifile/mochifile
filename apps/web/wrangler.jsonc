// Cloudflare Workers static assets: the site is served straight from `dist/` with no Worker
// script. Deployed by .github/workflows/deploy.yml (ADR 0013).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mochifile",
  // Release date of the pinned wrangler; only matters if a Worker script is added later.
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    // `/pt` redirects to `/pt/` and serves `pt/index.html`, matching `trailingSlash: 'always'`.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get `404.html` with a 404 status.
    "not_found_handling": "404-page"
  },
  // The canonical host (ADR 0015). Cloudflare creates the apex DNS record and certificate on
  // deploy, and never overwrites an existing record, so the Email Routing records are safe.
  // Domains live only here: a deploy removes Custom Domains that were added in the dashboard.
  // www.mochifile.com and mochifile.app redirect here through Cloudflare Redirect Rules.
  "routes": [{ "pattern": "mochifile.com", "zone_name": "mochifile.com", "custom_domain": true }],
  // Kept while the site is noindexed; must be set to false at launch (ADR 0014).
  "workers_dev": true,
  // Pull request previews (`wrangler preview`). Empty: an assets-only site has no
  // preview-specific variables or bindings.
  "previews": {}
}
